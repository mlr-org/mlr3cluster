linters: linters_with_defaults(
    # lintr defaults: https://lintr.r-lib.org/reference/default_linters.html
    assignment_linter = NULL, # the package uses = for assignment
    object_name_linter(c("snake_case", "CamelCase", "SNAKE_CASE")),
    commented_code_linter = NULL,
    line_length_linter(120L), # same as .editorconfig
    indentation_linter(indent = 2L, hanging_indent_style = "never"), # same as .editorconfig and air
    object_length_linter(40L),
    undesirable_function_linter(fun = c(
      # base messaging
      cat = "use catf()",
      stop = "use stopf()",
      warning = "use warningf()",
      message = "use messagef()",
      # misc
      which.min = "use which_min()",
      which.max = "use which_max()",
      # perf
      ifelse = "use fifelse()",
      rank = "use frank()",
      rev = "use frev()"
    ))
  )
